# Patched build of rmountjoy/DashMachine.
#
# Upstream's last commit is 2020-09-22 and the published image was never
# rebuilt. Its requirements.txt is unpinned, so building from source today
# resolves six years of new releases against python:3.8 (and fails). This
# therefore builds on the last published image and overlays only the fixed
# module, keeping the known-good 2020 dependency set exactly as it was.
#
# The base is pinned by digest so a rebuild cannot silently pick up a
# different image, and so the patch always applies to the code we tested.
FROM rmountjoy/dashmachine@sha256:497692b79838b042db0cb1d7ca8a28dfb20d0623fc7db705b8a42b055687e5a0

COPY dashmachine/main/utils.py /dashmachine/dashmachine/main/utils.py

# the image ships stale bytecode for this module; drop it so python
# recompiles from the patched source
RUN rm -rf /dashmachine/dashmachine/main/__pycache__
